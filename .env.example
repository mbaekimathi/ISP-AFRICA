# ISP CENTRIC configuration.
# Copy this file to .env (repo root or database/.env) and edit the values.
# Real environment variables always override this file.
# ISP_ENV_FILE=/path/to/file.env loads a different env file instead of .env.

# --- Environment -----------------------------------------------------------
# Set to "production" on the XPS. Development mode allows a built-in router
# API fallback password; production disables it. deploy\start-isp.cmd sets
# this for you (local -> development, prod -> production); the value here
# only applies when you start api.py directly.
ISP_ENV=production

# --- Account API + web app ---------------------------------------------------
# 127.0.0.1 = only this machine can open the dashboard.
# 0.0.0.0   = any machine that can reach this host can open it.
ISP_API_HOST=0.0.0.0
ISP_API_PORT=8765
# Folder holding the built React app. Defaults to ../frontend/dist.
#ISP_WEB_ROOT=C:\DEV OPS\SYSTEMS\isp\frontend\dist
# Max simultaneous HTTP handler threads for the API (default 64) and the
# captive portal (default 32). Extra connections queue instead of spawning
# unbounded threads.
#ISP_HTTP_WORKERS=64
#ISP_PORTAL_WORKERS=32
# Seconds an idle keep-alive connection may hold a worker slot (default 10).
#ISP_HTTP_KEEPALIVE=10

# --- MySQL ------------------------------------------------------------------
ISP_DB_HOST=127.0.0.1
ISP_DB_PORT=3306
ISP_DB_USER=root
ISP_DB_PASSWORD=
ISP_DB_NAME=ISP-DB
# Idle connections kept open for reuse (default 16). Requests share the pool —
# each new connection costs a full MySQL handshake, so the pool is what keeps
# API latency low under load.
#ISP_DB_POOL=16

# --- Secrets -----------------------------------------------------------------
# Change both on a real deployment. They seal router API passwords in the
# database and derive the customer-facing account codes.
ISP_ACCOUNT_CODE_SECRET=change-me-account-code-secret
ISP_ROUTER_SECRET=change-me-router-secret

# --- WireGuard management tunnel ----------------------------------------------
# Leave ISP_WG_PUBLIC_KEY unset on the machine that hosts the tunnel:
# api.py will then run the WireGuard side itself (key in database/wg/server.key,
# listens on UDP 51820, tunnel address 10.88.0.1).
# ISP_WG_ENDPOINT must be the address MikroTik routers use to reach this host
# (public IP, DNS name, or LAN IP if routers are on the same network).
# ISP_WG_PORT is the UDP port routers dial. Change it (e.g. 51821) when another
# WireGuard tunnel already owns 51820 on the same machine.
ISP_WG_ENDPOINT=
ISP_WG_PORT=51820
# Only set these when an EXTERNAL host terminates the tunnel instead:
#ISP_WG_PUBLIC_KEY=
#ISP_WG_LOCAL=1

# --- RADIUS -------------------------------------------------------------------
# Address routers send RADIUS to. Default 10.88.0.1 = this host over the tunnel.
ISP_RADIUS_HOST=10.88.0.1

# --- Captive portal ------------------------------------------------------------
# Address blocked/hotspot clients are redirected to. Default 10.88.0.1 = this
# host over the tunnel. PORTAL_HOST is the local bind interface.
ISP_PORTAL_IP=10.88.0.1
ISP_PORTAL_PORT=8790
ISP_PORTAL_HOST=0.0.0.0

# --- M-Pesa Daraja --------------------------------------------------------------
# Public HTTPS URL Safaricom can post callbacks to. The portal also polls
# stkpushquery, so payments still complete without it.
#ISP_DARAJA_CALLBACK=https://portal.example.com/callback
# Optional shared secret the callback must carry as ?key=... — append it to the
# callback URL above. When unset the callback is still accepted, but it can only
# annotate receipts; stkpushquery always decides whether a payment is real.
#ISP_DARAJA_CALLBACK_TOKEN=

# --- Company payment gateway ----------------------------------------------------
# AES-GCM key that seals the new gateway secrets (initiator password, callback
# secret, re-sealed consumer secret/passkey) stored in company_daraja_settings.
# Use a long random value; keep it out of the database and out of logs. Losing
# it makes every sealed gateway secret unrecoverable. When unset, production
# seals with ISP_ROUTER_SECRET instead (key id "s1") — keep that secret
# unchanged, or saved payment secrets must be re-entered. Development falls
# back to a built-in key.
#ISP_GATEWAY_SECRET=
# Labels which key sealed new values. Rotate by setting a new key + key id and
# listing retired keys below as "keyid=secret; keyid=secret" until re-sealed.
#ISP_GATEWAY_KEY_ID=g1
#ISP_GATEWAY_SECRETS_OLD=
# Safaricom public X.509 certificate for each environment — used to RSA-encrypt
# the initiator password into the B2C/B2B/Status/Balance SecurityCredential.
# Value is a PEM file path or the inline PEM. Download sandbox/production
# certs from the Daraja portal; never commit real credentials.
#ISP_DARAJA_CERT_SANDBOX=
#ISP_DARAJA_CERT_LIVE=
# Public HTTPS base Safaricom can reach this server on — e.g. a Cloudflare
# Tunnel or ngrok URL in dev, the VPS domain in production. Pooled STK pushes
# use it to build the /api/daraja/<secret>/stk callback. Leave blank to let
# api.py learn it automatically: the first time a director opens the company
# payments page through the public https domain (via the reverse proxy), the
# base is remembered in company_daraja_settings.public_base. Set this only
# to override the learned value — e.g. a tunnel the dashboard isn't reached
# through.
#ISP_GATEWAY_PUBLIC_URL=https://your-tunnel.example.com

# --- Workers --------------------------------------------------------------------
# Seconds between pooled-STK stale-payment sweeps (default 60).
#ISP_GATEWAY_SWEEP_SECONDS=60
#ISP_PPPOE_SWEEP_SECONDS=300
# Seconds between hotspot byte-limit passes — applies each package's data
# allowance and fair-use rule (throttle/disconnect/reset) to live guests
# (default 60).
#ISP_HOTSPOT_LIMIT_SECONDS=60
#ISP_ROUTER_CONCURRENCY=2
#ISP_ROUTER_JOB_TIMEOUT_SECONDS=8
#ISP_ROUTER_POLL_SECONDS=1
#ISP_JOB_RATE_PER_MINUTE=30
