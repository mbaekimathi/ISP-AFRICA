# Frontend (Vite) configuration. Copy to frontend/.env and restart the dev
# server after editing. Root .env values are only read by api.py — Vite only
# loads files in this folder.

# --- Site location search ----------------------------------------------------
# Google Places API key for the onboarding site autocomplete. Restrict it to
# this app's HTTP referrers and the Places API (New) in Google Cloud.
# Leave unset to search OpenStreetMap (Nominatim) instead — no key needed.
#VITE_GOOGLE_MAPS_API_KEY=
